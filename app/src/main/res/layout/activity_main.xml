<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F5F5F5">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SafeLab File Scanner"
        android:textSize="28sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="#2196F3"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/pickButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📁 Pick File to Scan"
        android:textSize="16sp"
        android:backgroundTint="#4CAF50"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/viewLogsButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📋 View Scan Logs"
        android:textSize="16sp"
        android:backgroundTint="#2196F3"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/clearLogsButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🗑️ Clear Logs"
        android:textSize="16sp"
        android:backgroundTint="#FF9800"
        android:layout_marginBottom="24dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FFFFFF"
        android:padding="12dp">

        <TextView
            android:id="@+id/resultText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ready to scan...\nSelect a file to begin analysis"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp"
            android:padding="8dp"/>

    </ScrollView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Logs saved to: Documents/SafeLab_Logs/"
        android:textSize="12sp"
        android:textColor="#757575"
        android:gravity="center"
        android:layout_marginTop="8dp"/>

</LinearLayout>